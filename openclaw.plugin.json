{
  "id": "skill-harness",
  "name": "Skill Harness",
  "description": "Pre-scans user intent before replies and injects routing context via before_prompt_build hook.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": ["skill_list", "skill_search", "skill_view", "skill_experience"]
  },
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["qmd"],
    "properties": {
      "allowedChatTypes": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["direct", "group", "channel", "explicit"]
        },
        "description": "Which chat types are eligible.",
        "default": ["direct"]
      },
      "allowedChatIds": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Allow-list of chat IDs.",
        "default": []
      },
      "deniedChatIds": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Deny-list of chat IDs.",
        "default": []
      },
      "agents": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Agent IDs eligible for intention scanning.",
        "default": ["main"]
      },
      "model": {
        "type": "string",
        "description": "Explicit lightweight model for the intention scanner (e.g. google/gemini-3-flash). If unset, resolves from the current session model, then the agent primary model, then modelFallback."
      },
      "modelFallback": {
        "type": "string",
        "description": "Last-resort scanner model after explicit, current-session, and agent-primary resolution. It is not a runtime retry model."
      },
      "thinking": {
        "type": "string",
        "enum": [
          "off",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "adaptive",
          "max"
        ],
        "description": "Thinking level for the intent classifier sub-agent.",
        "default": "medium"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "description": "Budget in milliseconds for each intention scanner sub-agent run.",
        "default": 5000
      },
      "qmd": {
        "type": "object",
        "description": "Required QMD remote services for mandatory hybrid intent routing. Each service may use an OpenAI-compatible endpoint and an optional direct API key.",
        "additionalProperties": false,
        "properties": {
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 60000,
            "description": "QMD remote embedding and query-expansion request budget in milliseconds. Defaults to timeoutMs."
          },
          "embedding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model"],
            "properties": {
              "baseUrl": {
                "type": "string",
                "description": "Optional base URL for OpenAI-compatible embeddings. If omitted, resolved from the OpenClaw provider prefix in model."
              },
              "model": {
                "type": "string",
                "description": "Embedding model name or OpenClaw 'provider/model' reference (e.g. 'bifrost/text-embedding-3-small')."
              },
              "apiKey": {
                "type": "string",
                "description": "Optional API key for embeddings. If omitted, resolved from the OpenClaw provider or environment."
              },
              "dimension": {
                "type": "integer",
                "minimum": 1,
                "default": 1536,
                "description": "Embedding vector dimension. Defaults to 1536."
              }
            }
          },
          "expansion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model"],
            "properties": {
              "baseUrl": {
                "type": "string",
                "description": "Optional base URL for OpenAI-compatible expansion. If omitted, resolved from the OpenClaw provider prefix in model."
              },
              "model": {
                "type": "string",
                "description": "Expansion model name or OpenClaw 'provider/model' reference (e.g. 'bifrost/gpt-4o-mini')."
              },
              "apiKey": {
                "type": "string",
                "description": "Optional API key for expansion. If omitted, resolved from the OpenClaw provider or environment."
              }
            }
          },
          "indexRefreshIntervalSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400,
            "default": 300,
            "description": "Seconds between source checks for QMD intent and skill index refreshes; 0 disables subsequent automatic checks."
          },
          "skillSearch": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional skill_search QMD collection weights.",
            "properties": {
              "collectionWeights": {
                "type": "object",
                "additionalProperties": false,
                "description": "Relative weights for weighted RRF across skill collections. Defaults to 1 for each collection.",
                "properties": {
                  "meta": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 1
                  },
                  "body": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 1
                  },
                  "references": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 1
                  }
                }
              }
            }
          }
        },
        "required": ["embedding", "expansion"]
      },
      "routing": {
        "type": "object",
        "description": "Optional QMD-score thresholds for dynamic intent routing. Invalid scores or ordering reject the plugin configuration.",
        "additionalProperties": false,
        "properties": {
          "qmd": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "directRouteMinScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.85,
                "description": "Inclusive QMD score required for direct routing bypass."
              },
              "minCandidateScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.35
              }
            }
          }
        }
      },
      "queryMode": {
        "type": "string",
        "enum": ["message", "recent", "full"],
        "description": "Context sent to scanner: latest message only, recent turns, or full history.",
        "default": "recent"
      },
      "contextWindow": {
        "type": "object",
        "description": "Turn and character limits for recent conversation context.",
        "additionalProperties": false,
        "properties": {
          "user": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "turns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20,
                "default": 5
              },
              "chars": {
                "type": "integer",
                "minimum": 40,
                "maximum": 1000,
                "default": 220
              }
            }
          },
          "assistant": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "turns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10,
                "default": 5
              },
              "chars": {
                "type": "integer",
                "minimum": 40,
                "maximum": 1000,
                "default": 180
              }
            }
          }
        },
        "default": {}
      },
      "review": {
        "type": "object",
        "description": "Optional post-turn Intent Review runs that validate and apply bounded runtime intent improvements.",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "model": {
            "type": "string",
            "description": "Explicit dedicated model for Intent Review runs. If unset, inherits the top-level model before current-session and agent-primary resolution."
          },
          "modelFallback": {
            "type": "string",
            "description": "Last-resort Intent Review model after explicit, current-session, and agent-primary resolution. It is not a runtime retry model."
          },
          "thinking": {
            "type": "string",
            "enum": [
              "off",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "adaptive",
              "max"
            ],
            "description": "Thinking level for the Intent Review sub-agent.",
            "default": "medium"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 1800,
            "default": 300,
            "description": "Budget in seconds for each Intent Review sub-agent run."
          },
          "keywordCoverage": {
            "type": "object",
            "description": "Automatic cross-session keyword coverage review cadence for accepted routed turns.",
            "additionalProperties": false,
            "properties": {
              "everyAcceptedTurns": {
                "type": "integer",
                "minimum": 10,
                "maximum": 1000,
                "default": 50
              }
            },
            "default": {}
          },
          "triggers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "skillCandidate": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "toolCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 5
                  }
                }
              },
              "skillPlacement": {
                "type": "object",
                "description": "Review one visible resolved skill when it has a low-adoption signal, or after 20 continuous turns with zero recommendations and usage.",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true }
                }
              },
              "processGap": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "toolFailures": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 2
                  }
                }
              },
              "successfulPattern": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "toolCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 5
                  },
                  "keywords": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Deprecated legacy seed. Accepted for configuration compatibility but ignored at runtime."
                  }
                }
              },
              "satisfactionCheck": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "everyTurns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "default": 10
                  }
                }
              },
              "missingIntent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true }
                }
              },
              "weakIntent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "confidenceBelow": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.5
                  }
                }
              },
              "behaviorFix": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "keywords": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Deprecated legacy seed. Accepted for configuration compatibility but ignored at runtime."
                  }
                }
              },
              "entityContext": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "keywords": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Deprecated legacy seed. Accepted for configuration compatibility but ignored at runtime."
                  }
                }
              }
            },
            "default": {}
          }
        },
        "default": {}
      }
    }
  }
}
