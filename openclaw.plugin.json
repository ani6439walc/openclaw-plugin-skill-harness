{
  "id": "skill-harness",
  "name": "Skill Harness",
  "description": "Pre-scans user intent before replies and injects routing context via before_prompt_build hook.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": ["skill_list", "skill_search", "skill_view", "skill_experience"]
  },
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["qmd"],
    "properties": {
      "scope": {
        "type": "object",
        "description": "Session, chat, and agent filtering.",
        "additionalProperties": false,
        "properties": {
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Agent IDs eligible for intention scanning.",
            "default": ["main"]
          },
          "chatTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["direct", "group", "channel", "explicit"]
            },
            "description": "Which chat types are eligible.",
            "default": ["direct"]
          },
          "allowedChatIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Allow-list of chat IDs.",
            "default": []
          },
          "deniedChatIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Deny-list of chat IDs.",
            "default": []
          }
        },
        "default": {}
      },
      "workingSetSkills": {
        "type": "object",
        "description": "Plugin-owned static skill working sets. Agent-specific skills are listed before shared defaults.",
        "additionalProperties": false,
        "properties": {
          "defaults": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agents": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "includeWorkspaceSkills": {
            "type": "boolean",
            "default": true,
            "description": "Whether to automatically discover and append workspace-only skills (<workspaceDir>/skills/) to the static working set."
          },
          "includeWorkshopSkills": {
            "type": "boolean",
            "default": true,
            "description": "Whether to automatically discover and append agent-specific workshop skills (.openclaw/agents/<agentId>/agent/workshop-skills/) to the agent's static working set."
          },
          "suppressNativeSkillPrompt": {
            "type": "boolean",
            "default": true,
            "description": "When enabled, automatically ensures agents.defaults.skills is [] and removes agents.entries.*.skills in openclaw.json on startup to suppress duplicate native OpenClaw <available_skills> prompts."
          }
        }
      },
      "routing": {
        "type": "object",
        "description": "Pre-turn dynamic intent routing thresholds and fallback classifier.",
        "additionalProperties": false,
        "properties": {
          "thresholds": {
            "type": "object",
            "description": "QMD-score thresholds for dynamic intent routing.",
            "additionalProperties": false,
            "properties": {
              "keyword": {
                "type": "object",
                "description": "Step 1 QMD keyword routing thresholds.",
                "additionalProperties": false,
                "properties": {
                  "directRouteMinScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.85,
                    "description": "Inclusive BM25 score required for keyword direct routing bypass."
                  }
                },
                "default": {}
              },
              "hybrid": {
                "type": "object",
                "description": "Step 2 QMD hybrid routing thresholds.",
                "additionalProperties": false,
                "properties": {
                  "directRouteMinScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.9,
                    "description": "Inclusive semantic score required for hybrid direct routing bypass."
                  },
                  "directRouteMinMargin": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.08,
                    "description": "Minimum score margin between #1 and #2 candidates required for hybrid direct routing."
                  },
                  "minCandidateScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.4,
                    "description": "Inclusive semantic score required to consider an intent candidate."
                  }
                },
                "default": {}
              }
            },
            "default": {}
          },
          "classifier": {
            "type": "object",
            "description": "Intent classifier sub-agent configuration for candidate adjudication.",
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string",
                "description": "Explicit lightweight model for the intention scanner (e.g. google/gemini-3-flash). If unset, resolves from current session model, agent primary model, then modelFallback."
              },
              "modelFallback": {
                "type": "string",
                "description": "Last-resort scanner model after explicit, current-session, and agent-primary resolution."
              },
              "thinking": {
                "type": "string",
                "enum": [
                  "off",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "adaptive",
                  "max"
                ],
                "description": "Thinking level for the intent classifier sub-agent.",
                "default": "medium"
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 60000,
                "description": "Budget in milliseconds for each intention scanner sub-agent run.",
                "default": 5000
              },
              "queryMode": {
                "type": "string",
                "enum": ["message", "recent", "full"],
                "description": "Context sent to scanner: latest message only, recent turns, or full history.",
                "default": "recent"
              },
              "contextWindow": {
                "type": "object",
                "description": "Turn and character limits for recent conversation context.",
                "additionalProperties": false,
                "properties": {
                  "user": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "turns": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 20,
                        "default": 5
                      },
                      "chars": {
                        "type": "integer",
                        "minimum": 40,
                        "maximum": 2000,
                        "default": 1000
                      }
                    }
                  },
                  "assistant": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "turns": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10,
                        "default": 5
                      },
                      "chars": {
                        "type": "integer",
                        "minimum": 40,
                        "maximum": 2000,
                        "default": 1000
                      }
                    }
                  }
                },
                "default": {}
              }
            },
            "default": {}
          }
        },
        "default": {}
      },
      "skills": {
        "type": "object",
        "description": "Skill dispatch and search configuration.",
        "additionalProperties": false,
        "properties": {
          "search": {
            "type": "object",
            "description": "Skill search QMD collection weights.",
            "additionalProperties": false,
            "properties": {
              "collectionWeights": {
                "type": "object",
                "additionalProperties": false,
                "description": "Relative weights (positive floats or integers, e.g. 1.5, 0.8) for weighted RRF across skill collections. Defaults to meta: 3, body: 2, references: 1.",
                "properties": {
                  "meta": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 3,
                    "description": "Relative RRF weight (positive float or integer, e.g. 1.5, 0.8) for the skill-meta collection."
                  },
                  "body": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 2,
                    "description": "Relative RRF weight (positive float or integer, e.g. 1.5, 0.8) for the skill-body collection."
                  },
                  "references": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 1,
                    "description": "Relative RRF weight (positive float or integer, e.g. 1.5, 0.8) for the skill-references collection."
                  }
                }
              }
            },
            "default": {}
          }
        },
        "default": {}
      },
      "qmd": {
        "type": "object",
        "description": "Required QMD remote services for mandatory hybrid intent routing and skill search. Each service may use an OpenAI-compatible endpoint and an optional direct API key.",
        "additionalProperties": false,
        "properties": {
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 60000,
            "description": "QMD remote embedding and query-expansion request budget in milliseconds. Defaults to timeoutMs."
          },
          "embedding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model"],
            "properties": {
              "baseUrl": {
                "type": "string",
                "description": "Optional base URL for OpenAI-compatible embeddings. If omitted, resolved from the OpenClaw provider prefix in model."
              },
              "model": {
                "type": "string",
                "description": "Embedding model name or OpenClaw 'provider/model' reference (e.g. 'bifrost/text-embedding-3-small')."
              },
              "apiKey": {
                "type": "string",
                "description": "Optional API key for embeddings. If omitted, resolved from the OpenClaw provider or environment."
              },
              "dimension": {
                "type": "integer",
                "minimum": 1,
                "default": 1536,
                "description": "Embedding vector dimension. Defaults to 1536."
              }
            }
          },
          "expansion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model"],
            "properties": {
              "baseUrl": {
                "type": "string",
                "description": "Optional base URL for OpenAI-compatible expansion. If omitted, resolved from the OpenClaw provider prefix in model."
              },
              "model": {
                "type": "string",
                "description": "Expansion model name or OpenClaw 'provider/model' reference (e.g. 'bifrost/gpt-4o-mini')."
              },
              "apiKey": {
                "type": "string",
                "description": "Optional API key for expansion. If omitted, resolved from the OpenClaw provider or environment."
              }
            }
          },
          "indexRefreshIntervalSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400,
            "default": 300,
            "description": "Seconds between source checks for QMD intent and skill index refreshes; 0 disables subsequent automatic checks."
          }
        },
        "required": ["embedding", "expansion"]
      },
      "review": {
        "type": "object",
        "description": "Optional asynchronous post-turn Intent Review. It can update future runtime intents but never participates in the current route decision.",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "model": {
            "type": "string",
            "description": "Explicit dedicated model for Intent Review runs. If unset, inherits the top-level model before current-session and agent-primary resolution."
          },
          "modelFallback": {
            "type": "string",
            "description": "Last-resort Intent Review model after explicit, current-session, and agent-primary resolution. It is not a runtime retry model."
          },
          "thinking": {
            "type": "string",
            "enum": [
              "off",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "adaptive",
              "max"
            ],
            "description": "Thinking level for the Intent Review sub-agent.",
            "default": "medium"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 1800,
            "default": 300,
            "description": "Budget in seconds for each Intent Review sub-agent run."
          },
          "triggers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intentHealthCheck": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "everyTurns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "default": 10
                  }
                }
              },
              "routingUncertainty": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "confidenceBelow": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.5
                  }
                }
              },
              "capabilityFit": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "toolCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 5
                  },
                  "toolFailures": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 2
                  }
                }
              }
            },
            "default": {}
          }
        },
        "default": {}
      }
    }
  }
}
