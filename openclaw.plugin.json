{
  "id": "skill-harness",
  "name": "Skill Harness",
  "description": "Pre-scans user intent before replies and injects routing context via before_prompt_build hook.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "skill_list",
      "skill_search",
      "skill_view",
      "skill_manage",
      "skill_experience"
    ]
  },
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "allowedChatTypes": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["direct", "group", "channel", "explicit"]
        },
        "description": "Which chat types are eligible.",
        "default": ["direct"]
      },
      "allowedChatIds": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Allow-list of chat IDs.",
        "default": []
      },
      "deniedChatIds": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Deny-list of chat IDs.",
        "default": []
      },
      "agents": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Agent IDs eligible for intention scanning.",
        "default": ["main"]
      },
      "model": {
        "type": "string",
        "description": "Explicit lightweight model for the intention scanner (e.g. google/gemini-3-flash). If unset, resolves from the current session model, then the agent primary model, then modelFallback."
      },
      "modelFallback": {
        "type": "string",
        "description": "Last-resort scanner model after explicit, current-session, and agent-primary resolution. It is not a runtime retry model."
      },
      "thinking": {
        "type": "string",
        "enum": [
          "off",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "adaptive",
          "max"
        ],
        "description": "Thinking level for the intent classifier sub-agent.",
        "default": "medium"
      },
      "lowEffortRoutingMode": {
        "type": "string",
        "enum": ["fastpath-only", "full", "off"],
        "description": "Intent-routing behavior when the main agent uses off, minimal, or low reasoning effort. fastpath-only preserves deterministic exact keyword hints but skips all LLM scanner sub-agents; full keeps the full pipeline; off disables the plugin for low-effort turns.",
        "default": "fastpath-only"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "description": "Budget in milliseconds for each intention scanner sub-agent run.",
        "default": 5000
      },
      "queryMode": {
        "type": "string",
        "enum": ["message", "recent", "full"],
        "description": "Context sent to scanner: latest message only, recent turns, or full history.",
        "default": "recent"
      },
      "contextWindow": {
        "type": "object",
        "description": "Turn and character limits for recent conversation context.",
        "additionalProperties": false,
        "properties": {
          "user": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "turns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20,
                "default": 5
              },
              "chars": {
                "type": "integer",
                "minimum": 40,
                "maximum": 1000,
                "default": 220
              }
            }
          },
          "assistant": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "turns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10,
                "default": 5
              },
              "chars": {
                "type": "integer",
                "minimum": 40,
                "maximum": 1000,
                "default": 180
              }
            }
          }
        },
        "default": {}
      },
      "curation": {
        "type": "object",
        "description": "Enabled-by-default background curator settings. Curation is independent of Intent Review and does not depend on review.enabled.",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "model": {
            "type": "string",
            "description": "Explicit dedicated model for the background curator. If unset, inherits the top-level model before current-session and agent-primary resolution."
          },
          "modelFallback": {
            "type": "string",
            "description": "Last-resort background curator model after explicit, current-session, and agent-primary resolution. It is not a runtime retry model."
          },
          "thinking": {
            "type": "string",
            "enum": [
              "off",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "adaptive",
              "max"
            ],
            "description": "Thinking level for the background curator sub-agent.",
            "default": "medium"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 600,
            "default": 30,
            "description": "Budget in seconds for each background curator sub-agent run."
          }
        },
        "default": {}
      },
      "review": {
        "type": "object",
        "description": "Optional post-turn Intent Review runs that validate and apply bounded runtime intent improvements.",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "model": {
            "type": "string",
            "description": "Explicit dedicated model for Intent Review runs. If unset, inherits the top-level model before current-session and agent-primary resolution."
          },
          "modelFallback": {
            "type": "string",
            "description": "Last-resort Intent Review model after explicit, current-session, and agent-primary resolution. It is not a runtime retry model."
          },
          "thinking": {
            "type": "string",
            "enum": [
              "off",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "adaptive",
              "max"
            ],
            "description": "Thinking level for the Intent Review sub-agent.",
            "default": "medium"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 1800,
            "default": 300,
            "description": "Budget in seconds for each Intent Review sub-agent run."
          },
          "keywordCoverage": {
            "type": "object",
            "description": "Automatic cross-session keyword coverage review cadence for accepted routed turns.",
            "additionalProperties": false,
            "properties": {
              "everyAcceptedTurns": {
                "type": "integer",
                "minimum": 10,
                "maximum": 1000,
                "default": 50
              }
            },
            "default": {}
          },
          "triggers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "skillCandidate": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "toolCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 5
                  }
                }
              },
              "skillPlacement": {
                "type": "object",
                "description": "Review one visible resolved skill when it has a low-adoption signal, or after 20 continuous turns with zero recommendations and usage.",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true }
                }
              },
              "processGap": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "toolFailures": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 2
                  }
                }
              },
              "successfulPattern": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "toolCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 5
                  },
                  "keywords": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Deprecated legacy seed. Accepted for configuration compatibility but ignored at runtime."
                  }
                }
              },
              "satisfactionCheck": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "everyTurns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "default": 10
                  }
                }
              },
              "missingIntent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true }
                }
              },
              "weakIntent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "confidenceBelow": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.5
                  }
                }
              },
              "behaviorFix": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "keywords": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Deprecated legacy seed. Accepted for configuration compatibility but ignored at runtime."
                  }
                }
              },
              "entityContext": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "keywords": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Deprecated legacy seed. Accepted for configuration compatibility but ignored at runtime."
                  }
                }
              }
            },
            "default": {}
          }
        },
        "default": {}
      }
    }
  }
}
