{
  "name": "skill-harness",
  "displayName": "Skill Harness",
  "description": "Pre-scans user intent before replies and injects routing hints via before_prompt_build hook.",
  "version": "2026.7.1-2",
  "type": "module",
  "license": "MIT",
  "author": "Ani <ani6439walc@gmail.com>",
  "contributors": [
    "Wan, Jiun Wei <wei840222@gmail.com>"
  ],
  "homepage": "https://github.com/ani6439walc/openclaw-plugin-skill-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ani6439walc/openclaw-plugin-skill-harness.git"
  },
  "bugs": {
    "url": "https://github.com/ani6439walc/openclaw-plugin-skill-harness/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "skill-harness"
  ],
  "files": [
    "README.md",
    "docs/**",
    "package.json",
    "openclaw.plugin.json",
    "dist",
    "skills/**"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.md' '**/*.json' '**/*.ts'",
    "test": "vitest run",
    "build": "rm -rf dist && tsc",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "typebox": "1.3.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "openclaw": "2026.7.1-2"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "prettier": "3.9.6"
  }
}
