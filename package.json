{
  "name": "skill-harness",
  "displayName": "Skill Harness",
  "description": "Pre-scans user intent before replies and injects routing context via before_prompt_build hook.",
  "version": "2026.9.5",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "license": "MIT",
  "author": "Ani <ani6439walc@gmail.com>",
  "contributors": [
    "Wan, Jiun Wei <wei840222@gmail.com>"
  ],
  "homepage": "https://github.com/ani6439walc/openclaw-plugin-skill-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ani6439walc/openclaw-plugin-skill-harness.git"
  },
  "bugs": {
    "url": "https://github.com/ani6439walc/openclaw-plugin-skill-harness/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "skill-harness"
  ],
  "files": [
    "README.md",
    "docs/**",
    "package.json",
    "openclaw.plugin.json",
    "dist",
    "skills/**"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.5",
      "minGatewayVersion": "2026.9.5"
    },
    "build": {
      "openclawVersion": "2026.9.5",
      "pluginSdkVersion": "2026.9.5"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.md' '**/*.json' '**/*.ts'",
    "test": "vitest run",
    "build": "tsc",
    "test:plugin-loader": "node --input-type=module --eval \"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url); require('./dist/index.js');\""
  },
  "dependencies": {
    "@wei840222/qmd": "2026.9.6",
    "gray-matter": "4.0.3",
    "typebox": "1.3.30",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "openclaw": "2026.9.5"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "prettier": "3.9.6"
  },
  "overrides": {
    "@node-llama-cpp/linux-arm64": "-",
    "@node-llama-cpp/linux-armv7l": "-",
    "@node-llama-cpp/linux-riscv64": "-",
    "@node-llama-cpp/linux-x64-cuda": "-",
    "@node-llama-cpp/linux-x64-cuda-ext": "-",
    "@node-llama-cpp/linux-x64-vulkan": "-",
    "@node-llama-cpp/mac-arm64-metal": "-",
    "@node-llama-cpp/mac-x64": "-",
    "@node-llama-cpp/win-arm64": "-",
    "@node-llama-cpp/win-x64": "-",
    "@node-llama-cpp/win-x64-cuda": "-",
    "@node-llama-cpp/win-x64-cuda-ext": "-",
    "@node-llama-cpp/win-x64-vulkan": "-"
  }
}
