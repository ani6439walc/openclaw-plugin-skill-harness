{
  "name": "skill-harness",
  "displayName": "Skill Harness",
  "description": "Discovers relevant skills and experiences before replies and injects routing context via before_prompt_build hook.",
  "version": "2026.10.10",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.8.1",
  "license": "MIT",
  "author": "Ani <ani6439walc@gmail.com>",
  "contributors": [
    "Wan, Jiun Wei <wei840222@gmail.com>"
  ],
  "homepage": "https://github.com/ani6439walc/openclaw-plugin-skill-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ani6439walc/openclaw-plugin-skill-harness.git"
  },
  "bugs": {
    "url": "https://github.com/ani6439walc/openclaw-plugin-skill-harness/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "skill-harness"
  ],
  "files": [
    "README.md",
    "AGENTS.md",
    "package.json",
    "openclaw.plugin.json",
    "dist",
    "scripts/runtime-health-audit.mjs",
    "scripts/validate-experiences.mjs",
    "scripts/import-skill-relations.mjs",
    "scripts/rebuild-skill-relations.mjs",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.10",
      "minGatewayVersion": "2026.10.10"
    },
    "build": {
      "openclawVersion": "2026.10.10",
      "pluginSdkVersion": "2026.10.10"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.md' '**/*.json' '**/*.ts' 'scripts/*{audit,experiences,relations}.mjs'",
    "test": "vitest run",
    "test:maintenance": "node scripts/test-runtime-health-audit.mjs && node scripts/test-validate-experiences.mjs",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc",
    "test:plugin-loader": "node --input-type=module --eval \"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url); require('./dist/index.js');\""
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0",
    "@wei840222/qmd": "2026.11.4",
    "gray-matter": "4.0.3",
    "typebox": "1.3.37",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "openclaw": "2026.10.10"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "prettier": "3.9.10"
  }
}
