{
  "name": "@ani6439walc/openclaw-plugin-skill-harness",
  "displayName": "Skill Harness",
  "description": "Discovers relevant skills and experiences before replies and injects routing context via before_prompt_build hook.",
  "version": "2026.9.9",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "license": "MIT",
  "author": "Ani <ani6439walc@gmail.com>",
  "contributors": [
    "Wan, Jiun Wei <wei840222@gmail.com>"
  ],
  "homepage": "https://github.com/ani6439walc/openclaw-plugin-skill-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ani6439walc/openclaw-plugin-skill-harness.git"
  },
  "bugs": {
    "url": "https://github.com/ani6439walc/openclaw-plugin-skill-harness/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "skill-harness"
  ],
  "files": [
    "README.md",
    "package.json",
    "openclaw.plugin.json",
    "dist",
    "skills/**",
    "!skills/**/__pycache__/**",
    "!skills/**/*.py[cod]"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.9",
      "minGatewayVersion": "2026.9.9"
    },
    "build": {
      "openclawVersion": "2026.9.9",
      "pluginSdkVersion": "2026.9.9"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.md' '**/*.json' '**/*.ts'",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "@wei840222/qmd": "2026.10.6",
    "gray-matter": "4.0.3",
    "typebox": "1.3.30",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "openclaw": "2026.9.9"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
